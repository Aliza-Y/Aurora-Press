# Normalize text files (Windows ↔ Unix)
* text=auto

# Force LF for code
*.py   text eol=lf
*.ts   text eol=lf
*.tsx  text eol=lf
*.js   text eol=lf
*.mjs  text eol=lf
*.css  text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf

# Keep Windows endings for Windows scripts
*.bat text eol=crlf
*.ps1 text eol=crlf
